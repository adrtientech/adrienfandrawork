# ==============================================================================
# CREATOR OUTBOUND AI CRM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Salin file ini menjadi .env lalu isi variabel di bawah ini.
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (WAJIB)
# ------------------------------------------------------------------------------
PORT=3001

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE (WAJIB UNTUK DATA NYATA)
# Dapatkan di: https://supabase.com/dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key digunakan di /server untuk bypass RLS dengan aman
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opsional untuk frontend Vite jika ingin direct query client-side
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. AI ENGINE: GOOGLE GEMINI (WAJIB UNTUK ANALISIS & DRAFT EMAIL)
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. GOOGLE SEARCH API: SERPER.DEV (WAJIB UNTUK INVESTIGASI BRAND & FOUNDER)
# Dapatkan gratis (2.500 pencarian) di: https://serper.dev
# ------------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# 5. WEB SCRAPING: JINA READER (OPSIONAL)
# https://jina.ai/reader/ - Bekerja gratis tanpa API Key!
# Isi hanya jika ingin rate limit lebih tinggi (opsional).
# ------------------------------------------------------------------------------
JINA_API_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL OUTREACH: GOOGLE GMAIL API OAUTH2 (WAJIB UNTUK OUTREACH OTOMATIS)
# Dapatkan Client ID & Secret di: https://console.cloud.google.com/apis/credentials
# Lalu jalankan "npm run gmail:auth" untuk mendapatkan REFRESH_TOKEN secara otomatis.
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//04...
GMAIL_USER_EMAIL=adrien@yourdomain.co

# ------------------------------------------------------------------------------
# 7. FITUR PENGAMAN UJI COBA (SANGAT PENTING!)
# Jika SAFE_TEST_MODE=true, SEMUA email keluar dialihkan ke TEST_RECIPIENT_EMAIL
# sehingga brand luar negeri TIDAK akan menerima email uji coba Anda.
# ------------------------------------------------------------------------------
SAFE_TEST_MODE=true
TEST_RECIPIENT_EMAIL=your_personal_testing_email@gmail.com

# ------------------------------------------------------------------------------
# 8. NOTIFIKASI INSTAN TELEGRAM (OPSIONAL - PENGAMAN #4)
# Buat bot gratis via @BotFather di Telegram untuk menerima notif saat brand membalas.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 9. TAMENG VERIFIKASI EMAIL / BOUNCE SHIELD: VERIFALIA API (OPSIONAL - PENGAMAN #1)
# Sistem sudah dilengkapi DNS MX Record & Syntax/Disposable Shield bawaan (gratis).
# Isi kredensial Verifalia (https://verifalia.com) jika ingin deep SMTP mailbox check.
# ------------------------------------------------------------------------------
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=

# ------------------------------------------------------------------------------
# 10. LAMPIRAN FILE PDF MEDIA KIT LOKAL (OPSIONAL - TAHAP B3)
# Jika file PDF ditaruh di path ini, Gmail Draft otomatis melampirkan file PDF fisik
# selain menyertakan tautan Media Kit di dalam body email balasan.
# ------------------------------------------------------------------------------
MEDIA_KIT_PDF_PATH=./public/media-kit-adrien.pdf
